#!/usr/bin/env node
// Ersatz für claude in Tests des Helfers: schreibt jeden Aufruf nach $FAKE_STATE/calls.jsonl und antwortet je nach
// $FAKE_STATE/mode.json ({"mode": "ok" | "rich" | "denied" | "limit" | "limit-old" | "error" | "auth" | "authexpired" |
// "refreshlock" | "maxturns" | "noresult" | "huge" | "toobig", "delayMs": …}). "rich" antwortet mit Formeln, Liste, Code
// und Quellen (Links), zum Ansehen der Karte in der App; "denied" antwortet, meldet aber abgelehnte Werkzeuge; "toobig"
// scheitert nur beim Fortsetzen eines Chats (--resume) mit mode.message (Standard „Prompt is too long“), ein neuer Chat
// antwortet; "noresult" hört ohne Zeile result und ohne Meldung auf (wie abgestürzt).
// `claude auth status` sagt angemeldet (Exit 0), wenn $FAKE_STATE/auth.json {"loggedIn": true} enthält.
// Fragen mit --output-format stream-json: erst eine Zeile system/init, dann je gelesener Datei ein Read (assistant mit
// tool_use, absolute Pfade, mehrere auf einmal in einer Zeile) und sein Ergebnis (user mit tool_result, is_error bei einer
// fehlenden Datei), zuletzt result. Was gelesen wird, steht in mode.json: "readWeitere": [3, 9] (weitere/seite-3.pdf …
// neben der Frage), "readDokument": "4-6" (dokument.pdf mit pages), "readFail": [9] (diese weiteren Seiten scheitern, wie
// eine zu große Datei); "bigLines": n und "bigLineMB": m schicken davor n
// Ergebnis-Zeilen von je m MB (wie Base64 eines großen PDFs). Jeder Aufruf hält in calls.jsonl auch fest, was in
// weitere/ neben der Frage liegt (Name, Größe, nlink, Verweis), sonst null
const fs = require("fs"), path = require("path");
const DIR = process.env.FAKE_STATE || path.join(require("os").tmpdir(), "betternotes-fake");
fs.mkdirSync(DIR, { recursive: true });
const args = process.argv.slice(2);
if (args[0] === "auth" && args[1] === "status") {
  let a = { loggedIn: false };
  try { a = JSON.parse(fs.readFileSync(path.join(DIR, "auth.json"), "utf8")); } catch {}
  fs.appendFileSync(path.join(DIR, "calls.jsonl"), JSON.stringify({ authStatus: a.loggedIn }) + "\n");
  process.stdout.write(JSON.stringify({ loggedIn: !!a.loggedIn }) + "\n");
  process.exit(a.loggedIn ? 0 : 1);
}
if (args[0] === "--help") {
  // help.json: { "version": "new" | "old", "stream": false } – new lists --restricted and dontAsk, old neither; both
  // know stream-json, unless stream is false
  let h = { version: "new" };
  try { h = JSON.parse(fs.readFileSync(path.join(DIR, "help.json"), "utf8")); } catch {}
  fs.appendFileSync(path.join(DIR, "calls.jsonl"), JSON.stringify({ help: h.version, envKeys: Object.keys(process.env).filter((k) => /NOTIZBUCH|BETTERNOTES/i.test(k)) }) + "\n");
  const lines = ["Usage: claude [options] [command] [prompt]", "  -p, --print   Print response and exit"];
  lines.push(h.stream === false ? '  --output-format <format>  Output format (only works with --print): "text" (default) or "json"'
    : '  --output-format <format>  Output format (only works with --print): "text" (default), "json" (single result), or "stream-json" (realtime streaming) (choices: "text", "json", "stream-json")');
  if (h.version === "new") {
    lines.push('  --permission-mode <mode>  Permission mode (choices: "acceptEdits", "bypassPermissions", "default", "dontAsk", "plan")');
    lines.push("  --restricted   Restrict file tools to the working directories");
    lines.push("", "Commands:", "  auth                      Manage authentication", "  update|upgrade            Check for updates");
  } else {
    lines.push('  --permission-mode <mode>  Permission mode (choices: "acceptEdits", "bypassPermissions", "default", "plan")');
  }
  process.stdout.write(lines.join("\n") + "\n");
  process.exit(0);
}
const get = (f) => { const i = args.indexOf(f); return i >= 0 ? args[i + 1] : undefined; };
let mode = { mode: "ok" };
try { mode = JSON.parse(fs.readFileSync(path.join(DIR, "mode.json"), "utf8")); } catch {}
const sessions = path.join(DIR, "sessions");
fs.mkdirSync(sessions, { recursive: true });
// stream-json: die Nachricht kommt über stdin (Bild + Text), wie beim Lesen der Lernwörter
let stdinMsg = null;
if (get("--input-format") === "stream-json") {
  try { stdinMsg = JSON.parse(fs.readFileSync(0, "utf8").trim().split("\n")[0]); } catch {}
}
const streamText = stdinMsg?.message?.content?.find?.((c) => c.type === "text")?.text;
const streamImage = stdinMsg?.message?.content?.find?.((c) => c.type === "image");
const pArg = get("-p");
const prompt = (pArg && !pArg.startsWith("--") ? pArg : "") || streamText || "";
// Dateien, die die Nachricht nennt (ohne den Platzhalter seite-<Nummer>.pdf der weiteren Seiten)
const files = [...prompt.matchAll(/(fragen\/[^\s:]+|dokument\.pdf)/g)].map((m) => m[1]).filter((f) => !f.includes("<"));
const sizes = Object.fromEntries(files.map((f) => [f, fs.existsSync(f) ? fs.statSync(f).size : -1]));
// Der Ordner der Frage (aus dem Bild der Frage in der Nachricht) und was in weitere/ daneben liegt
const qdir = (prompt.match(/(fragen\/[^\s:/]+)\/frage\.(?:png|jpg)/) || [])[1] || null;
const weitereDir = qdir ? path.join(process.cwd(), qdir, "weitere") : null;
let weitere = null;
try {
  weitere = fs.readdirSync(weitereDir).sort().map((name) => {
    const st = fs.lstatSync(path.join(weitereDir, name));
    return { name, size: st.size, nlink: st.nlink, symlink: st.isSymbolicLink(), file: st.isFile() };
  });
} catch {}
const rec = { t: Date.now(), args, stream: !!stdinMsg, imageBytes: streamImage ? Buffer.from(streamImage.source.data, "base64").length : 0, streamPrompt: streamText || null, cwd: process.cwd(), envKeys: Object.keys(process.env).filter((k) => /NOTIZBUCH|BETTERNOTES/i.test(k)), stdinTTY: process.stdin.isTTY || false, mode: mode.mode, sizes, weitere, pid: process.pid };
fs.appendFileSync(path.join(DIR, "calls.jsonl"), JSON.stringify(rec) + "\n");
if (mode.noStream && stdinMsg) { process.stderr.write("Error: stream-json input not supported\n"); process.exit(1); }
const resume = get("--resume"), sid = get("--session-id");
if (resume && !fs.existsSync(path.join(sessions, resume))) {
  process.stderr.write(`No conversation found with session ID: ${resume}\n`);
  process.exit(1);
}
if (sid && fs.existsSync(path.join(sessions, sid))) { process.stderr.write(`Error: Session ID ${sid} is already in use.\n`); process.exit(1); }
const session = resume || sid;
fs.writeFileSync(path.join(sessions, session), "x");
process.on("SIGTERM", () => { fs.appendFileSync(path.join(DIR, "calls.jsonl"), JSON.stringify({ killed: process.pid }) + "\n"); process.exit(143); });
const out = (o) => { process.stdout.write(JSON.stringify(o) + "\n"); };
// stream-json einer Frage (nicht Lernwörter oder Vokabeln): zuerst system/init, wie Claude Code beim Start
const streaming = get("--output-format") === "stream-json";
const lernish = /Buchstabe für Buchstabe|Vokabelliste|Gesucht war/.test(prompt);
const init = () => {
  if (streaming && !lernish) out({ type: "system", subtype: "init", cwd: process.cwd(), session_id: session, tools: String(get("--tools") || "").split(","), mcp_servers: [], model: "fake", permissionMode: get("--permission-mode") || "default", apiKeySource: "none" });
};
// Die Reads aus mode.json (readWeitere, readDokument) samt Ergebnissen, dann die langen Zeilen (bigLines)
const readLines = () => {
  const reads = [];
  for (const n of mode.readWeitere || []) if (weitereDir) reads.push({ input: { file_path: path.join(weitereDir, `seite-${n}.pdf`) }, fail: (mode.readFail || []).includes(n) });
  if (mode.readDokument) reads.push({ input: { file_path: path.join(process.cwd(), "dokument.pdf"), pages: String(mode.readDokument) } });
  if (reads.length) {
    const uses = reads.map((r, i) => ({ type: "tool_use", id: `toolu_fake${i}`, name: "Read", input: r.input }));
    out({ type: "assistant", message: { id: "msg_fake1", type: "message", role: "assistant", model: "fake", content: uses }, parent_tool_use_id: null, session_id: session });
    for (const [i, u] of uses.entries()) {
      let content, isError = false;
      try {
        if (reads[i].fail) throw new Error("File content (31.2MB) exceeds maximum allowed size (20MB).");
        content = [{ type: "document", source: { type: "base64", media_type: "application/pdf", data: fs.readFileSync(u.input.file_path).toString("base64") } }];
      } catch (e) {
        content = reads[i].fail ? e.message : "File does not exist.";
        isError = true;
      }
      out({ type: "user", message: { role: "user", content: [{ tool_use_id: u.id, type: "tool_result", content, ...(isError ? { is_error: true } : {}) }] }, parent_tool_use_id: null, session_id: session });
    }
  }
  if (mode.bigLines) {
    const data = "A".repeat(Math.round((mode.bigLineMB || 10) * 1e6));
    for (let i = 0; i < mode.bigLines; i++) out({ type: "user", message: { role: "user", content: [{ tool_use_id: "toolu_big", type: "tool_result", content: [{ type: "document", source: { type: "base64", media_type: "application/pdf", data } }] }] }, parent_tool_use_id: null, session_id: session });
  }
};
// Lernwörter: mit stream-json erst die Antwort als assistant-Zeile, dann (wie Claude Code) nach mode.summaryMs eine
// Zusammenfassung und erst danach result
const lernOut = (t) => {
  const done = () => process.stdout.write(JSON.stringify({ type: "result", subtype: "success", is_error: false, result: t, session_id: session }) + "\n", () => process.exit(0));
  if (get("--output-format") !== "stream-json") return done();
  out({ type: "assistant", session_id: session, message: { role: "assistant", content: [{ type: "text", text: t }] } });
  setTimeout(() => { out({ type: "system", subtype: "post_turn_summary" }); done(); }, mode.summaryMs || 0);
};
const finish = () => {
  if (mode.mode !== "error") init();
  if (mode.mode === "limit") {
    // Wie Claude Code heute: Ende in Ortszeit (hier vor zwei Minuten, also gleich wieder frei)
    const t = new Date(Date.now() - 120000), h = t.getHours();
    const at = `${h % 12 || 12}:${String(t.getMinutes()).padStart(2, "0")}${h < 12 ? "am" : "pm"}`;
    out({ type: "result", subtype: "success", is_error: true, result: `You've hit your session limit · resets ${at}`, session_id: session });
    process.exit(1);
  }
  if (mode.mode === "limit-old") {
    out({ type: "result", subtype: "success", is_error: true, result: `Claude AI usage limit reached|${Math.floor(Date.now() / 1000) - 120}`, session_id: session });
    process.exit(1);
  }
  if (mode.mode === "authexpired") {
    out({ type: "result", subtype: "success", is_error: true, result: "Failed to authenticate: OAuth session expired and could not be refreshed", session_id: session });
    process.exit(1);
  }
  if (mode.mode === "refreshlock") {
    out({ type: "result", subtype: "success", is_error: true, result: "Failed to refresh OAuth token: another Claude Code process is refreshing it or exited mid-refresh. This is usually transient; retry in a minute.", session_id: session });
    process.exit(1);
  }
  if (mode.mode === "error") { process.stderr.write("Something broke\n"); process.exit(1); }
  if (mode.mode === "auth") {
    out({ type: "result", subtype: "success", is_error: true, result: "Invalid API key · Please run /login", session_id: session });
    process.exit(1);
  }
  if (mode.mode === "denied") {
    out({ type: "result", subtype: "success", is_error: false, result: "Antwort ohne die Datei", session_id: session,
      permission_denials: [{ tool_name: "Read", tool_use_id: "t1", tool_input: { file_path: "/etc/hosts" } },
        { tool_name: "WebFetch", tool_use_id: "t2", tool_input: { url: "https://example.com/" } }] });
    process.exit(0);
  }
  if (mode.mode === "toobig" && resume) {
    out({ type: "result", subtype: "success", is_error: true, result: mode.message || "Prompt is too long", session_id: session });
    process.exit(1);
  }
  if (mode.mode === "maxturns") {
    out({ type: "result", subtype: "error_max_turns", is_error: true, session_id: session });
    process.exit(1);
  }
  // "noresult": bricht ab wie abgestürzt, ohne Zeile result und ohne Meldung; mit stream-json davor die Reads und eine
  // Zeile mit Text aus einer Seite
  if (mode.mode === "noresult") {
    if (streaming) {
      readLines();
      out({ type: "assistant", message: { id: "msg_fake3", type: "message", role: "assistant", model: "fake", content: [{ type: "text", text: "Auf Seite 1 steht: Geheimnis aus dem Heft" }] }, parent_tool_use_id: null, session_id: session });
    }
    process.stdout.write("", () => process.exit(1));
    return;
  }
  const rich = [
    "**Kurz:** Die Ableitung ist $f'(x) = 2x\\sin x + x^2\\cos x$ (Produktregel).",
    "",
    "1. Erster Faktor: $(x^2)' = 2x$",
    "2. Zweiter Faktor: $(\\sin x)' = \\cos x$",
    "",
    "$$\\int_0^1 x^2\\,dx = \\frac{1}{3}, \\qquad \\sum_{n=1}^{\\infty} \\frac{1}{n^2} = \\frac{\\pi^2}{6}$$",
    "",
    "Ebenso \\(e^{i\\pi} + 1 = 0\\) und abgesetzt",
    "\\[ \\lim_{h \\to 0} \\frac{f(x+h) - f(x)}{h} = f'(x) \\]",
    "",
    "Eine sehr lange Formel: $$" + Array.from({ length: 30 }, (_, i) => `a_{${i}} x^{${i}}`).join(" + ") + "$$",
    "",
    "`Code` und > ein Zitat",
    "",
    "Quellen: [Produktregel (Wikipedia)](https://de.wikipedia.org/wiki/Produktregel) und https://de.wikipedia.org/wiki/Differentialrechnung",
  ].join("\n");
  // Lernwörter: Lesen antwortet mit mode.gelesen (Standard „Farad“), der Hinweis mit einem festen Satz, im Codeblock
  if (prompt.includes("Buchstabe für Buchstabe")) {
    const t = mode.unleserlich ? '{"gelesen": "", "unleserlich": true}' : JSON.stringify({ gelesen: mode.gelesen ?? "Farad" });
    return lernOut(t);
  }
  // Vokabelfotos: zwei Vokabeln, eine mit Satz aus dem Buch; mode.vokabelnLeer: keine Liste erkannt
  if (prompt.includes("Vokabelliste")) {
    const t = mode.vokabelnLeer
      ? JSON.stringify({ titel: "", sprache: "", karten: [], problem: "Ich sehe keine Vokabeln." })
      : "Hier:\n" + JSON.stringify({ titel: "Unit 3", sprache: "Englisch", geheim: "weg", karten: [
        { fremd: "dog", deutsch: "Hund", satz: "My dog likes to run.", satzSelbst: true, extra: 1 },
        { fremd: "to go – went – gone", deutsch: "gehen", satz: "We go to school.", satzSelbst: false },
        { fremd: "", deutsch: "leer" }] });
    return lernOut(t);
  }
  if (prompt.includes("Gesucht war")) {
    const t = "```json\n" + JSON.stringify({ hinweis: "Hör genau hin: Nach dem kurzen a kommt ein doppelter Mitlaut." }) + "\n```";
    return lernOut(t);
  }
  // "huge": eine Antwort über der Grenze des Servers (200 000 Zeichen), die er mit 413 ablehnt
  // "write": wie Claude bei „Claude schreiben lassen“, Sätze für die Sprechblase und ein Block mit Notizen
  const write = "Zwei Fehler am Rand markiert, die Lösung unter den Auftrag geschrieben.\n\n```notizen\n" + JSON.stringify([
    { seite: 2, x: 84, y: 30, breite: 14, text: "Vorzeichen: $-2$", farbe: "rot", größe: "klein", kasten: [10, 29, 60, 32] },
    { seite: 1, x: 10, y: 55, breite: 80, text: "$$\\int_0^1 x\\,dx = \\tfrac12$$" },
    { seite: 40, x: 10, y: 10, breite: 50, text: "außerhalb" },
  ]) + "\n```\n";
  const text = mode.mode === "rich" ? rich : mode.mode === "write" ? write : mode.mode === "huge" ? "x".repeat(210000) : `Antwort (${get("--effort")}) auf ${files.join(", ")}: $x^2$`;
  if (streaming) {
    readLines();
    out({ type: "assistant", message: { id: "msg_fake2", type: "message", role: "assistant", model: "fake", content: [{ type: "text", text }] }, parent_tool_use_id: null, session_id: session });
  }
  // Erst beenden, wenn alles geschrieben ist: Eine lange Antwort passt nicht auf einmal in die Pipe
  process.stdout.write(JSON.stringify({ type: "result", subtype: "success", is_error: false, result: text, session_id: session }) + "\n", () => process.exit(0));
};
setTimeout(finish, mode.delayMs || 200);
