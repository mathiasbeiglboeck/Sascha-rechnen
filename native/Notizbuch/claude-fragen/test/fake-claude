#!/usr/bin/env node
// Ersatz für claude in Tests des Helfers: schreibt jeden Aufruf nach $FAKE_STATE/calls.jsonl und antwortet je nach
// $FAKE_STATE/mode.json ({"mode": "ok" | "rich" | "denied" | "limit" | "limit-old" | "error" | "auth" | "authexpired" |
// "refreshlock" | "maxturns" | "huge", "delayMs": …}). "rich" antwortet mit Formeln, Liste, Code und Quellen (Links), zum
// Ansehen der Karte in der App; "denied" antwortet, meldet aber abgelehnte Werkzeuge. `claude auth status` sagt angemeldet (Exit 0), wenn $FAKE_STATE/auth.json {"loggedIn": true} enthält
const fs = require("fs"), path = require("path");
const DIR = process.env.FAKE_STATE || path.join(require("os").tmpdir(), "betternotes-fake");
fs.mkdirSync(DIR, { recursive: true });
const args = process.argv.slice(2);
if (args[0] === "auth" && args[1] === "status") {
  let a = { loggedIn: false };
  try { a = JSON.parse(fs.readFileSync(path.join(DIR, "auth.json"), "utf8")); } catch {}
  fs.appendFileSync(path.join(DIR, "calls.jsonl"), JSON.stringify({ authStatus: a.loggedIn }) + "\n");
  process.stdout.write(JSON.stringify({ loggedIn: !!a.loggedIn }) + "\n");
  process.exit(a.loggedIn ? 0 : 1);
}
if (args[0] === "--help") {
  // help.json: { "version": "new" | "old" } – new lists --restricted and dontAsk, old neither
  let h = { version: "new" };
  try { h = JSON.parse(fs.readFileSync(path.join(DIR, "help.json"), "utf8")); } catch {}
  fs.appendFileSync(path.join(DIR, "calls.jsonl"), JSON.stringify({ help: h.version, envKeys: Object.keys(process.env).filter((k) => /NOTIZBUCH|BETTERNOTES/i.test(k)) }) + "\n");
  const lines = ["Usage: claude [options] [command] [prompt]", "  -p, --print   Print response and exit"];
  if (h.version === "new") {
    lines.push('  --permission-mode <mode>  Permission mode (choices: "acceptEdits", "bypassPermissions", "default", "dontAsk", "plan")');
    lines.push("  --restricted   Restrict file tools to the working directories");
    lines.push("", "Commands:", "  auth                      Manage authentication", "  update|upgrade            Check for updates");
  } else {
    lines.push('  --permission-mode <mode>  Permission mode (choices: "acceptEdits", "bypassPermissions", "default", "plan")');
  }
  process.stdout.write(lines.join("\n") + "\n");
  process.exit(0);
}
const get = (f) => { const i = args.indexOf(f); return i >= 0 ? args[i + 1] : undefined; };
let mode = { mode: "ok" };
try { mode = JSON.parse(fs.readFileSync(path.join(DIR, "mode.json"), "utf8")); } catch {}
const sessions = path.join(DIR, "sessions");
fs.mkdirSync(sessions, { recursive: true });
// stream-json: die Nachricht kommt über stdin (Bild + Text), wie beim Lesen der Lernwörter
let stdinMsg = null;
if (get("--input-format") === "stream-json") {
  try { stdinMsg = JSON.parse(fs.readFileSync(0, "utf8").trim().split("\n")[0]); } catch {}
}
const streamText = stdinMsg?.message?.content?.find?.((c) => c.type === "text")?.text;
const streamImage = stdinMsg?.message?.content?.find?.((c) => c.type === "image");
const pArg = get("-p");
const prompt = (pArg && !pArg.startsWith("--") ? pArg : "") || streamText || "";
const files = [...prompt.matchAll(/(fragen\/[^\s:]+|dokument\.pdf)/g)].map((m) => m[1]);
const sizes = Object.fromEntries(files.map((f) => [f, fs.existsSync(f) ? fs.statSync(f).size : -1]));
const rec = { t: Date.now(), args, stream: !!stdinMsg, imageBytes: streamImage ? Buffer.from(streamImage.source.data, "base64").length : 0, streamPrompt: streamText || null, cwd: process.cwd(), envKeys: Object.keys(process.env).filter((k) => /NOTIZBUCH|BETTERNOTES/i.test(k)), stdinTTY: process.stdin.isTTY || false, mode: mode.mode, sizes, pid: process.pid };
fs.appendFileSync(path.join(DIR, "calls.jsonl"), JSON.stringify(rec) + "\n");
if (mode.noStream && stdinMsg) { process.stderr.write("Error: stream-json input not supported\n"); process.exit(1); }
const resume = get("--resume"), sid = get("--session-id");
if (resume && !fs.existsSync(path.join(sessions, resume))) {
  process.stderr.write(`No conversation found with session ID: ${resume}\n`);
  process.exit(1);
}
if (sid && fs.existsSync(path.join(sessions, sid))) { process.stderr.write(`Error: Session ID ${sid} is already in use.\n`); process.exit(1); }
const session = resume || sid;
fs.writeFileSync(path.join(sessions, session), "x");
process.on("SIGTERM", () => { fs.appendFileSync(path.join(DIR, "calls.jsonl"), JSON.stringify({ killed: process.pid }) + "\n"); process.exit(143); });
const out = (o) => { process.stdout.write(JSON.stringify(o) + "\n"); };
// Lernwörter: mit stream-json erst die Antwort als assistant-Zeile, dann (wie Claude Code) nach mode.summaryMs eine
// Zusammenfassung und erst danach result
const lernOut = (t) => {
  const done = () => process.stdout.write(JSON.stringify({ type: "result", subtype: "success", is_error: false, result: t, session_id: session }) + "\n", () => process.exit(0));
  if (get("--output-format") !== "stream-json") return done();
  out({ type: "assistant", session_id: session, message: { role: "assistant", content: [{ type: "text", text: t }] } });
  setTimeout(() => { out({ type: "system", subtype: "post_turn_summary" }); done(); }, mode.summaryMs || 0);
};
const finish = () => {
  if (mode.mode === "limit") {
    // Wie Claude Code heute: Ende in Ortszeit (hier vor zwei Minuten, also gleich wieder frei)
    const t = new Date(Date.now() - 120000), h = t.getHours();
    const at = `${h % 12 || 12}:${String(t.getMinutes()).padStart(2, "0")}${h < 12 ? "am" : "pm"}`;
    out({ type: "result", subtype: "success", is_error: true, result: `You've hit your session limit · resets ${at}`, session_id: session });
    process.exit(1);
  }
  if (mode.mode === "limit-old") {
    out({ type: "result", subtype: "success", is_error: true, result: `Claude AI usage limit reached|${Math.floor(Date.now() / 1000) - 120}`, session_id: session });
    process.exit(1);
  }
  if (mode.mode === "authexpired") {
    out({ type: "result", subtype: "success", is_error: true, result: "Failed to authenticate: OAuth session expired and could not be refreshed", session_id: session });
    process.exit(1);
  }
  if (mode.mode === "refreshlock") {
    out({ type: "result", subtype: "success", is_error: true, result: "Failed to refresh OAuth token: another Claude Code process is refreshing it or exited mid-refresh. This is usually transient; retry in a minute.", session_id: session });
    process.exit(1);
  }
  if (mode.mode === "error") { process.stderr.write("Something broke\n"); process.exit(1); }
  if (mode.mode === "auth") {
    out({ type: "result", subtype: "success", is_error: true, result: "Invalid API key · Please run /login", session_id: session });
    process.exit(1);
  }
  if (mode.mode === "denied") {
    out({ type: "result", subtype: "success", is_error: false, result: "Antwort ohne die Datei", session_id: session,
      permission_denials: [{ tool_name: "Read", tool_use_id: "t1", tool_input: { file_path: "/etc/hosts" } },
        { tool_name: "WebFetch", tool_use_id: "t2", tool_input: { url: "https://example.com/" } }] });
    process.exit(0);
  }
  if (mode.mode === "maxturns") {
    out({ type: "result", subtype: "error_max_turns", is_error: true, session_id: session });
    process.exit(1);
  }
  const rich = [
    "**Kurz:** Die Ableitung ist $f'(x) = 2x\\sin x + x^2\\cos x$ (Produktregel).",
    "",
    "1. Erster Faktor: $(x^2)' = 2x$",
    "2. Zweiter Faktor: $(\\sin x)' = \\cos x$",
    "",
    "$$\\int_0^1 x^2\\,dx = \\frac{1}{3}, \\qquad \\sum_{n=1}^{\\infty} \\frac{1}{n^2} = \\frac{\\pi^2}{6}$$",
    "",
    "Ebenso \\(e^{i\\pi} + 1 = 0\\) und abgesetzt",
    "\\[ \\lim_{h \\to 0} \\frac{f(x+h) - f(x)}{h} = f'(x) \\]",
    "",
    "Eine sehr lange Formel: $$" + Array.from({ length: 30 }, (_, i) => `a_{${i}} x^{${i}}`).join(" + ") + "$$",
    "",
    "`Code` und > ein Zitat",
    "",
    "Quellen: [Produktregel (Wikipedia)](https://de.wikipedia.org/wiki/Produktregel) und https://de.wikipedia.org/wiki/Differentialrechnung",
  ].join("\n");
  // Lernwörter: Lesen antwortet mit mode.gelesen (Standard „Farad“), der Hinweis mit einem festen Satz, im Codeblock
  if (prompt.includes("Buchstabe für Buchstabe")) {
    const t = mode.unleserlich ? '{"gelesen": "", "unleserlich": true}' : JSON.stringify({ gelesen: mode.gelesen ?? "Farad" });
    return lernOut(t);
  }
  if (prompt.includes("Gesucht war")) {
    const t = "```json\n" + JSON.stringify({ hinweis: "Hör genau hin: Nach dem kurzen a kommt ein doppelter Mitlaut." }) + "\n```";
    return lernOut(t);
  }
  // "huge": eine Antwort über der Grenze des Servers (200 000 Zeichen), die er mit 413 ablehnt
  const text = mode.mode === "rich" ? rich : mode.mode === "huge" ? "x".repeat(210000) : `Antwort (${get("--effort")}) auf ${files.join(", ")}: $x^2$`;
  // Erst beenden, wenn alles geschrieben ist: Eine lange Antwort passt nicht auf einmal in die Pipe
  process.stdout.write(JSON.stringify({ type: "result", subtype: "success", is_error: false, result: text, session_id: session }) + "\n", () => process.exit(0));
};
setTimeout(finish, mode.delayMs || 200);
